{
  "version": 1,
  "workflows": [
    {
      "id": "build-stage",
      "name": "Run build on stage",
      "description": "Build the Shopware storefront as deploy",
      "host": "shop-stage",
      "cwd": "/var/www/shopware",
      "timeout": 1800,
      "steps": [
        [
          "sudo",
          "-n",
          "-u",
          "deploy",
          "bin/build-storefront.sh"
        ]
      ],
      "notifications": true,
      "group": "shopware",
      "icon": "󰏗"
    },
    {
      "id": "local-check",
      "name": "Local check",
      "description": "An independent workflow without a group",
      "icon": "✓",
      "steps": [
        [
          "printf",
          "Workflow runner is ready.\n"
        ]
      ]
    }
  ],
  "groups": [
    {
      "id": "shopware",
      "title": "Shopware",
      "description": "Build and maintain your storefront",
      "icon": "󰒓"
    }
  ]
}
